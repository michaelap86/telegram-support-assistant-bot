# Telegram
TELEGRAM_TOKEN=
TELEGRAM_BOT_USERNAME=
# Public https address of the app (webhook mode). Leave empty to use long polling locally.
PUBLIC_URL=
# Chat that receives human-handoff requests (send /id to the bot to find yours)
ADMIN_CHAT_ID=

# Language model (OpenAI). Without a key the bot still answers from the knowledge base.
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# Spending guards
USER_DAILY_LIMIT=30
GLOBAL_DAILY_BUDGET_USD=1.00
MAX_OUTPUT_TOKENS=350

# Admin dashboard (/admin)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
